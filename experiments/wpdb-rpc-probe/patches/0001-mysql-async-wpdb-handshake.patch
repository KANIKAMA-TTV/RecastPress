 #[cfg(test)]
 mod test {
     use super::{HostPortOrUrl, MysqlOpts, Opts, Url};
+
+    #[test]
+    fn rp_legacy_handshake_capability_defaults_are_preserved() {
+        use crate::consts::CapabilityFlags as C;
+        let opts = Opts::default();
+        let original = C::CLIENT_PROTOCOL_41 | C::CLIENT_SECURE_CONNECTION
+            | C::CLIENT_LONG_PASSWORD | C::CLIENT_TRANSACTIONS | C::CLIENT_LOCAL_FILES
+            | C::CLIENT_MULTI_STATEMENTS | C::CLIENT_MULTI_RESULTS | C::CLIENT_PS_MULTI_RESULTS
+            | C::CLIENT_DEPRECATE_EOF | C::CLIENT_PLUGIN_AUTH;
+        assert_eq!(opts.get_capabilities(), original);
+        assert!(!opts.client_found_rows());
+        assert!(opts.multi_statements() && opts.local_files());
+    }
+
+    #[test]
+    fn rp_wpdb_handshake_clears_only_selected_optional_capabilities() {
+        use crate::consts::CapabilityFlags as C;
+        let opts = Opts::from(super::OptsBuilder::default()
+            .client_found_rows(false).multi_statements(false).local_files(false));
+        let removed = C::CLIENT_FOUND_ROWS | C::CLIENT_MULTI_STATEMENTS | C::CLIENT_LOCAL_FILES;
+        assert_eq!(opts.get_capabilities(), Opts::default().get_capabilities() & !removed);
+        assert!(!opts.get_capabilities().intersects(removed));
+        assert!(opts.get_capabilities().contains(C::CLIENT_MULTI_RESULTS));
+    }
