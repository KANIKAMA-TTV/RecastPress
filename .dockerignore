# Default deny: only release build sources and notices enter this context.
**
!Cargo.toml
!Cargo.lock
!LICENSE
!NOTICE.md
!LICENSES/
!LICENSES/*.txt
!crates/
!crates/recastpress-core/
!crates/recastpress-core/Cargo.toml
!crates/recastpress-core/src/
!crates/recastpress-core/src/**
!crates/recastpress-server/
!crates/recastpress-server/Cargo.toml
!crates/recastpress-server/src/
!crates/recastpress-server/src/**
!crates/recastpress-wp/
!crates/recastpress-wp/Cargo.toml
!crates/recastpress-wp/src/
!crates/recastpress-wp/src/**
!crates/recastpress-db/
!crates/recastpress-db/Cargo.toml
!crates/recastpress-db/src/
!crates/recastpress-db/src/**
!deploy/
!deploy/development/
!deploy/development/Dockerfile
# Defense in depth inside otherwise allowed source trees.
**/.git
**/.reference
**/target
**/assets
**/credentials
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/__pycache__
